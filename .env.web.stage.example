# Copy to .env.web.stage on the server. Never commit the filled-in version.
COMPOSE_PROJECT_NAME=beekeeping-web-stage
IMAGE=ghcr.io/hryhoriikorsun/beekeepingfrontend:main

WEB_HOST=stage.med.com.ua

# Staging is closed to strangers and hidden from search engines. The names are
# prefixed with COMPOSE_PROJECT_NAME above.
WEB_MIDDLEWARES=beekeeping-web-stage-auth@docker,beekeeping-web-stage-noindex@docker
STAGE_BASICAUTH=
